# onshape-mcp — example config. COPY to `.env` and fill in.
# NEVER commit your real `.env` — it's gitignored, keep it that way.

# Plain-JSON file holding your Onshape session cookies. Created by
# `python -m onshape_mcp.driver login`. We store cookies as JSON (not
# in Chrome's encrypted DB) because Chrome's keyring isn't accessible
# from headless sessions on Linux.
ONSHAPE_COOKIE_FILE=./cookies/onshape.cookies.json

# Persistent profile dir for cache + local storage. Not used for cookies.
ONSHAPE_BROWSER_PROFILE=./playwright-profile

# Path to the file holding your Gemini web cookies (__Secure-1PSID +
# __Secure-1PSIDTS). Exported from your Chrome via
# scripts/extract_cookies_from_chrome.py.
GEMINI_COOKIE_FILE=./cookies/gemini.cookies.json

# Where the agent's action journal + screenshots land.
JOURNAL_DIR=./state
LOG_DIR=./logs

# Gemini model id (web). Use the one your Plus plan unlocks.
# Typical: "gemini-2.5-pro", "gemini-2.5-flash", "gemini-2.0-flash-thinking"
GEMINI_MODEL=gemini-2.5-pro

# Chat session management:
# Set GEMINI_TEMPORARY_CHAT=true (default) so automated/test runs do not save
# or pollute your Gemini web conversation history.
GEMINI_TEMPORARY_CHAT=true
# Set GEMINI_AUTO_CLEANUP=true (default) to delete any non-temporary chats
# spawned during the session on close/exit.
GEMINI_AUTO_CLEANUP=true

# Onshape document to operate on by default (optional).
# Format: d/<docId>/e/<elementId>
ONSHAPE_DEFAULT_DOC=

# Browser channel: "auto" tries real Chrome first then bundled Chromium,
# "chrome" requires Chrome (errors if missing), "chromium" uses bundled
# Chromium only. Set to "chromium" on a Pi with no Chrome installed.
ONSHAPE_BROWSER_CHANNEL=auto
